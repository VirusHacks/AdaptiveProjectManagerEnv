# Copy this file to .env and fill in your own values.

# Hugging Face token or API key used by the OpenAI client
HF_TOKEN=your_hugging_face_token_here

# Optional fallback if you prefer a different variable name
API_KEY=

# Optional: override the OpenAI-compatible router endpoint
API_BASE_URL=https://router.huggingface.co/v1

# Optional: override the default model
MODEL_NAME=Qwen/Qwen2.5-72B-Instruct

# Optional: local Docker image name for the environment
LOCAL_IMAGE_NAME=hustlers_env-env:latest
